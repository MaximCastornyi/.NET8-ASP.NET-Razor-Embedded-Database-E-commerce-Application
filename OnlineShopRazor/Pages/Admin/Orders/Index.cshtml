@page
@model OnlineShopRazor.Pages.Admin.Orders.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].CompanyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Comment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].CouponCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].CouponDiscount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Shipping)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].SubTotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].CreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].TransId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order[0].LastName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Order) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.CompanyName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Country)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.City)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(model => item.Comment)
            </td>
            <td>
                @Html.DisplayFor(model => item.CouponCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.CouponDiscount)
            </td>
            <td>
                @Html.DisplayFor(model => item.Shipping)
            </td>
            <td>
                @Html.DisplayFor(model => item.SubTotal)
            </td>
            <td>
                @Html.DisplayFor(model => item.Total)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreateDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.TransId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
